# native/versions.env — pinned component versions for the native installer
# (native/install.sh). Part of qbittorrent-vpn-docker, MIT License.
#
# This file is read as plain KEY=VALUE data (it is never `source`d), one
# setting per line. Blank lines and lines starting with # are ignored.
#
# How to bump a component:
#   1. Change its version line below.
#   2. Update its checksum (or commit) lines. `native/install.sh pins`
#      downloads each pinned file and prints the sha256 to paste here; for a
#      git source use `git ls-remote <repo> 'refs/tags/<tag>^{}'` (or the
#      plain tag line when there is no ^{} line).
#   3. In the container: bash /opt/torrent-stack/native/install.sh self-update
#      (or the Proxmox/Incus host script's --update). Only the components
#      whose lines changed are reinstalled and restarted.
#
# Every download is checked against the sha256 or commit below before it is
# used. A mismatch stops the install instead of running an unexpected file.
# Python packages are pinned the same way in native/locks/*.txt.
# Versions were current stable releases on 2026-11-08.

# --- Go toolchain, used only to build Gluetun, deleted after the build ---
# https://go.dev/dl/ (sha256 values from https://go.dev/dl/?mode=json)
GO_VERSION=1.27.3
GO_SHA256_AMD64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
GO_SHA256_ARM64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49

# --- Gluetun VPN client, built from source (https://github.com/qdm12/gluetun) ---
# GLUETUN_COMMIT is what the tag points at; the clone is rejected otherwise.
GLUETUN_VERSION=v3.41.3
GLUETUN_COMMIT=3d1e20c5551e9cae1f9d938dc7b7214a6987f27e

# --- qBittorrent-nox, static build (https://github.com/userdocs/qbittorrent-nox-static) ---
# Release tag format: release-<qBittorrent version>_v<libtorrent version>.
QBITTORRENT_RELEASE=release-5.3.0_v2.1.2
QBITTORRENT_SHA256_AMD64=563e695a2b830e62e627e1ae403bcfcc494e444d5cabb5ecc1e09907353d8ed5
QBITTORRENT_SHA256_ARM64=ac1e57089795270489491320c5fff0ceaed8e8910cf3abb6be597879408eb033

# --- VueTorrent, qBittorrent's alternative web UI (https://github.com/VueTorrent/VueTorrent) ---
VUETORRENT_VERSION=v2.36.1
VUETORRENT_SHA256=70b67531f0f3bc36c8bd05d82cc7ba1ee37c71c17f0b6c45f522200e35e66f37

# --- Jackett indexer proxy, self-contained binaries (https://github.com/Jackett/Jackett) ---
JACKETT_VERSION=v0.24.3030
JACKETT_SHA256_AMD64=715a3d5c1374d6f34cb6756c9aa90ea47c1f63e94cb0b556e2396b49c5140c40
JACKETT_SHA256_ARM64=630da3bbba61f723179a316b0ec65906ca03f3832e0ef491aa20bdb7e5581bc8

# --- FlareSolverr, run from source like its official Docker image ---
# (https://github.com/FlareSolverr/FlareSolverr). Uses Debian's chromium and
# chromium-driver packages. Its Python packages, dependencies included, are
# pinned with sha256 hashes in native/locks/flaresolverr.txt (regenerate that
# file when you bump this version; see native/README.md).
FLARESOLVERR_VERSION=v3.5.2
FLARESOLVERR_COMMIT=93125d6ea6956906c8dfa29e169b2dc67d993dc3

# --- FileBrowser Quantum (https://github.com/gtsteffaniak/filebrowser) ---
# The compose stack uses the :stable image tag; this is that channel's release.
FILEBROWSER_VERSION=v2.0.2-stable
FILEBROWSER_SHA256_AMD64=5710dc6f51d77f1db884eace44f6952286c49f2ce40b6a59af37e0dc7c4a8bbd
FILEBROWSER_SHA256_ARM64=03eac074efc1b0ef3cb39882c04eeee26027049d261b6b6706650d4ac2d8e21c

# --- qBittorrent's Jackett search plugin (https://github.com/qbittorrent/search-plugins) ---
# Pinned to a commit so the file qBittorrent runs is a known one. Installed
# only when the plugin file is missing. The seeding CLI
# (scripts/env-editor/seed_configs.py, used by the env-editor and every
# Docker-style installer) reads these two lines too and refuses a download
# whose sha256 differs.
QBIT_SEARCH_PLUGINS_COMMIT=b67ae21eee8ed26715f31c0c33619dc606dd5f8e
QBIT_JACKETT_PLUGIN_SHA256=650b6d24b68e75a2b1a17db5b620f949809a5201e6823b388f7069fe6ca68d66
