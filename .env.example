# .env.example — copy to `.env` and fill in. `.env` is gitignored.

# ----------------------------------------------------
# -- Paths and System Settings
# ----------------------------------------------------
# User and Group ID the containers run as. 1000/1000 is the first non-root
# user on Debian/Ubuntu/Fedora hosts. Run `id -u` and `id -g` to confirm.
# Do NOT set to 0 — PUID=0/PGID=0 makes the linuxserver.io init skip the
# privilege drop and runs the app as root. If the host has only a root user
# (e.g. the stock docker-pve VM), create one first:
#   useradd -u 1000 -m -s /bin/bash deploy && usermod -aG docker deploy
# and make sure the paths below are owned by that uid/gid.
PUID=1000
PGID=1000
# Local timezone for consistent timestamps in logs.
TZ=America/New_York
# Base path on the host where all per-service configuration folders live.
CONFIG_PATH=./configs
# Completed and in-progress download paths.
DOWNLOADS_PATH=./downloads
INCOMPLETE_DOWNLOADS=./downloads/incomplete

# ----------------------------------------------------
# -- VPN Configuration (Gluetun)
# ----------------------------------------------------
# Protocol: wireguard or openvpn.
VPN_TYPE=wireguard
# Gluetun provider slug — see https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# NOTE: VPN port forwarding (required by this stack) is only supported by
#   protonvpn, private internet access, perfect privacy, privatevpn.
# NordVPN, Mullvad, AirVPN etc. do NOT work for the port-forward path; the
# stack will connect but qBittorrent will stay stuck on an inbound port of 0.
VPN_PROVIDER=protonvpn

# --- OpenVPN Settings (only used if VPN_TYPE=openvpn) ---
# ProtonVPN users: append `+pmp` to the username to enable port forwarding
# (e.g. `username+pmp`). Not needed for other providers.
OPENVPN_USER=your_openvpn_username
OPENVPN_PASSWORD=your_openvpn_password
OPENVPN_PROTOCOL=udp

# --- WireGuard Settings (only used if VPN_TYPE=wireguard) ---
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key
WIREGUARD_ADDRESSES=0.0.0.0/32

# --- General VPN Settings ---
# `on` restricts server selection to port-forward-capable servers.
PORT_FORWARD_ONLY=on
# `on` enables the port-forwarding feature (required by update-qbittorrent.sh).
VPN_PORT_FORWARDING=on
# Comma-separated country filter for the VPN exit.
SERVER_COUNTRIES=United States

# ----------------------------------------------------
# -- Application Ports (host side)
# ----------------------------------------------------
QBIT_WEBUI_PORT=8090
JACKETT_PORT=9117
FLARESOLVERR_PORT=8191
FILEBROWSER_PORT=8081

# ----------------------------------------------------
# -- qBittorrent Integration
# ----------------------------------------------------
# qBittorrent WebUI credentials used by update-qbittorrent.sh. The LinuxServer
# qBittorrent image prints a temporary admin password to the container log on
# first start (`docker compose logs qbittorrent`). Set a permanent password in
# Tools -> Options -> Web UI, then put it here.
QBITTORRENT_USER=your_qbit_username
QBITTORRENT_PASSWORD=your_qbit_password
# Discord webhook URL for the port-update script's success/error pings.
SCRIPT_NOTIFY_URL=https://discord.com/api/webhooks/your_id/your_token

# ----------------------------------------------------
# -- Watchtower Notifications
# ----------------------------------------------------
# Shoutrrr-formatted URL for Watchtower notifications. Modern Watchtower
# auto-detects shoutrrr from the URL scheme.
WATCHTOWER_NOTIFICATION_URL=discord://your_watchtower_token@your_watchtower_webhook_id
# Verbosity (debug, info, warn). `debug` fires a ping on every image check
# (chatty); `info` only fires on actual updates/errors.
WATCHTOWER_NOTIFICATION_LEVEL=info
# Prefix prepended to all Watchtower notifications.
WATCHTOWER_TITLE_TAG="qBittorrent Stack"
# 6-field cron for the Watchtower sweep.
WATCHTOWER_SCHEDULE="0 30 15 * * *"
